{
  "kind": "collectionType",
  "collectionName": "floorings",
  "info": {
    "singularName": "flooring",
    "pluralName": "floorings",
    "displayName": "Flooring"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "code": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true,
      "unique": true
    },
    "description": {
      "type": "richtext"
    },
    "technical_details": {
      "type": "component",
      "repeatable": true,
      "component": "shared.spec-item"
    },
    "projects": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::project.project",
      "mappedBy": "floorings"
    },
    "related_floorings": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::flooring.flooring"
    },
    "media": {
      "type": "component",
      "repeatable": true,
      "component": "shared.media-item"
    }
  }
}
